# Jarvis runtime
# run.ps1 generates a strong private value automatically on first start.
OPENJARVIS_API_KEY=change-me

# Local bindings
PORT=8000
DASHBOARD_PORT=8765

# Local Ollama backend (default)
JARVIS_MODEL=qwen3.5:2b

# Optional cloud backends. Leave empty when using Ollama.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
