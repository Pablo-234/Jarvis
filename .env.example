# Jarvis runtime
# Generate a long random value before exposing the API outside localhost.
OPENJARVIS_API_KEY=change-me-to-a-long-random-secret

# Runtime binding
HOST=0.0.0.0
PORT=8000

# Local Ollama backend (default)
OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_MODEL=qwen3.5:2b

# Optional cloud backends. Leave empty when using Ollama.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
