# Jarvis runtime
# run.ps1 generates a strong private value automatically on first start.
OPENJARVIS_API_KEY=change-me

# Local bindings
PORT=8000
DASHBOARD_PORT=8765

# Local Ollama backend (default worker)
JARVIS_MODEL=qwen3.5:9b

# Strategic cloud brain. GPT-5.6 is the alias for GPT-5.6 Sol.
# Keep the API key only in your local .env; never commit it.
JARVIS_STRATEGIC_MODEL=gpt-5.6
OPENAI_API_KEY=

# Optional additional cloud backends.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
